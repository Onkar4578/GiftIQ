# Free key: https://aistudio.google.com/apikey  (leave blank to run in keyword-fallback mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=sqlite:///./giftiq.db
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=10
AI_TIMEOUT_SECONDS=30
GST_RATE=0.18
DISPATCH_BUFFER_DAYS=2
# Set to true only when running behind a reverse proxy you control
TRUST_PROXY=false
LOG_LEVEL=INFO
